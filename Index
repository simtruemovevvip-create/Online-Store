    var qrLoginTimer=null,qrLoginBusy=false;
    function startQrLoginPolling(challenge,rememberAfterQr){
      stopQrLoginPolling();qrLoginBusy=false;
      qrLoginTimer=setInterval(function(){
        if(qrLoginBusy)return;
        qrLoginBusy=true;
        apiCall('customerGetQrLoginStatus',[challenge],function(r){
          qrLoginBusy=false;
          if(!r.success){var status=document.getElementById('qrLoginStatus');if(status)status.textContent=r.message||'ตรวจสอบ QR ไม่สำเร็จ';return;}
          var d=r.data||{};
          if(d.status==='pending')return;
          if(d.status==='expired'||d.status==='used'){
            stopQrLoginPolling();var msg=document.getElementById('qrLoginStatus');if(msg)msg.textContent=d.status==='expired'?'QR Code หมดอายุ กรุณาปิดหน้าต่างแล้วลองใหม่':'QR Code นี้ถูกใช้งานแล้ว';return;
          }
          if(d.status==='approved'&&d.token){
            stopQrLoginPolling();Swal.close();
            finishCustomerLogin({success:true,data:{token:d.token,customer:d.customer}},'เข้าสู่ระบบด้วย QR Code สำเร็จ',rememberAfterQr);
          }
        });
