    function uploadCustomerProfileImage(fileInput){
      var file=fileInput&&fileInput.files&&fileInput.files[0];if(!file)return;
      if(file.type.indexOf('image/')!==0){alertError('กรุณาเลือกไฟล์รูปภาพ');fileInput.value='';return;}
      if(file.size>5*1024*1024){alertError('รูปโปรไฟล์ต้องมีขนาดไม่เกิน 5 MB');fileInput.value='';return;}
      var reader=new FileReader();
      reader.onload=function(){
        var localPreview=String(reader.result||'');
        apiCall('uploadFile',[APP.customerToken,{accountType:'customer',folder:'Customers',purpose:'profile',name:file.name,mimeType:file.type,data:localPreview,visibility:'public'}],function(r){
          if(!r||!r.success){alertError(r&&r.message?r.message:'อัปโหลดรูปโปรไฟล์ไม่สำเร็จ');return;}
          var field=document.getElementById('pfProfileImage'),preview=document.getElementById('pfProfilePreview'),fallback=document.getElementById('pfProfileFallback');
          if(r.data&&r.data.displayable){
            var url=r.data.profileUrl||r.data.url;
            if(field)field.value=url;
            if(preview){preview.src=imageUrl(url);preview.style.display='block';preview.onerror=function(){this.onerror=null;this.src=localPreview;};}
            if(fallback)fallback.style.display='none';
            if(r.data.profileImageSaved){APP.customer=APP.customer||{};APP.customer.profileImage=url;}
            toast(r.data.profileImageSaved?'อัปโหลดและบันทึกรูปโปรไฟล์แล้ว':'อัปโหลดรูปโปรไฟล์สำเร็จ','success',r.data.profileImageSaved?'บันทึก URL ลง Google Sheets: Customers.profileImage แล้ว':'ต้นฉบับยังเป็น Private ใน Google Drive และเว็บไซต์จะแสดงผ่านระบบตรวจสิทธิ์');if(r.data.profileImageSaved){customerPortalRefreshProfile();if(document.getElementById('customerProfileInfoPage'))renderCustomerProfilePage(APP.customer);}
          }
          else{if(field)field.value='';if(preview){preview.src=localPreview;preview.style.display='block';preview.dataset.localOnly='true';}if(fallback)fallback.style.display='none';toast('บันทึกไฟล์แล้ว แต่ยังใช้เป็นรูปโปรไฟล์บนเว็บไซต์ไม่ได้','warning',((r.data&&r.data.warning)||'ไม่สามารถลงทะเบียนรูปโปรไฟล์ส่วนตัวได้ กรุณาลองอีกครั้ง')+((r.data&&r.data.sharingError)?' รายละเอียด: '+r.data.sharingError:''));}
        },true,'กำลังอัปโหลดรูปโปรไฟล์...');
      };
      reader.onerror=function(){alertError('ไม่สามารถอ่านไฟล์รูปภาพได้');};
      reader.readAsDataURL(file);fileInput.value='';
    }

