  <script id="storefront-nav-active-state-v1">
    (function(){
      function setMainNavActive(key){
        var nav=document.getElementById('mainNav');
        if(!nav)return;
        var links=nav.querySelectorAll('a[data-nav-key]');
        for(var i=0;i<links.length;i++){
          var active=links[i].getAttribute('data-nav-key')===key;
          links[i].classList.toggle('active',active);
          if(active)links[i].setAttribute('aria-current','page');
          else links[i].removeAttribute('aria-current');
        }
        nav.classList.remove('open');
      }
      window.setMainNavActive=setMainNavActive;

      window.navigateToHomeSection=function(id){
        if(!document.getElementById(id)||APP.currentView!=='home')goHome();
        var attempts=0;
        function scrollWhenReady(){
          var target=document.getElementById(id);
          if(target){
            target.scrollIntoView({behavior:'smooth',block:'start'});
            setMainNavActive(id==='categories'?'categories':id);
            return;
          }
          if(attempts++<40)setTimeout(scrollWhenReady,100);
        }
        scrollWhenReady();
      };

      function wrapNavAction(name,key,shouldActivate){
        var original=window[name];
        if(typeof original!=='function')return;
        window[name]=function(){
          var result=original.apply(this,arguments);
          if(!shouldActivate||shouldActivate())setMainNavActive(key);
          return result;
        };
      }
      wrapNavAction('goHome','home',function(){return APP.accessMode!=='seller'&&APP.accessMode!=='owner';});
      wrapNavAction('showAllProducts','products');
      wrapNavAction('showStores','stores');
      wrapNavAction('showStorePage','stores');
      wrapNavAction('showFlashDeals','flash');
      wrapNavAction('showMarketplaceVouchers','vouchers');
      wrapNavAction('loadBestSellers','best');
      wrapNavAction('loadNewArrivals','new');
      wrapNavAction('showPromotions','promotions');
      wrapNavAction('showAbout','about');
      wrapNavAction('showContact','contact');
      wrapNavAction('viewProduct','products');
      wrapNavAction('filterCategory','products');
      wrapNavAction('openChatInbox','chat',function(){return !!APP.customerToken;});
    })();
  </script>


