        if(!answer.isConfirmed)return;
        var busy=setInlineButtonBusy(button,'กำลังลบ...');
        apiCall('deleteBanner',[APP.adminToken,row.id],function(r){
          restoreInlineButton(busy);
          if(!r||!r.success){alertError(r&&r.message||'ลบแบนเนอร์ไม่สำเร็จ');return;}
          APP.adminHeroBanners.splice(index,1);renderAdminHeroBannerManager();toast('ลบแบนเนอร์แล้ว','success');
        },false,'',true);
      });
    }

