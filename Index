        APP.settings=Object.assign({},APP.settings,d);loadAdminSettings(function(ok,message){if(!ok){restoreInlineButton(busy);alertError('บันทึกแล้วแต่โหลดการตั้งค่าล่าสุดไม่สำเร็จ: '+message);return;}applySettings();toast(r.message,'success','การตั้งค่าร้านค้าถูกบันทึกและโหลดกลับมาแล้ว');});
