    function saveAdminHeroBanner(index,button){
      var rows=safeArray(APP.adminHeroBanners),old=rows[index];if(!old)return;
      var value=function(id){var el=document.getElementById(id);return el?el.value:'';};
      var title=value('adminHeroTitle_'+index).trim(),image=value('adminHeroImage_'+index).trim();
      if(!title){alertError('กรุณาระบุชื่อแบนเนอร์');return;}
      if(!image){alertError('กรุณาอัปโหลดหรือใส่ URL รูปแบนเนอร์');return;}
      var position=value('adminHeroPosition_'+index);
      var status=(document.getElementById('adminHeroStatus_'+index)||{}).checked?'Active':'Inactive';
      if(status==='Active'&&position!=='main'){
        var duplicate=rows.some(function(item,itemIndex){
          return itemIndex!==index&&String(item.position||'')===position&&String(item.status||'Active')==='Active';
        });
        if(duplicate){alertError(position==='side-top'?'มีแบนเนอร์ด้านขวาบนที่เปิดใช้งานอยู่แล้ว กรุณาย้ายหรือปิดรายการเดิมก่อน':'มีแบนเนอร์ด้านขวาล่างที่เปิดใช้งานอยู่แล้ว กรุณาย้ายหรือปิดรายการเดิมก่อน');return;}
      }
      var data=Object.assign({},old,{
        title:title,image:image,position:position,
        order:Math.max(0,Number(value('adminHeroOrder_'+index)||0)),
        url:value('adminHeroUrl_'+index).trim(),status:status
      });
      var busy=setInlineButtonBusy(button,'กำลังบันทึก...');
      apiCall('saveBanner',[APP.adminToken,data],function(r){
        restoreInlineButton(busy);
        if(!r||!r.success){alertError(r&&r.message||'บันทึกแบนเนอร์ไม่สำเร็จ');return;}
        APP.adminHeroBanners[index]=r.data||data;
        renderAdminHeroBannerManager();
        toast('บันทึกแบนเนอร์แล้ว','success');
      },false,'',true);
    }
    function deleteAdminHeroBanner(index,button){
      var row=safeArray(APP.adminHeroBanners)[index];if(!row||!row.id)return;
