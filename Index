    function handleAdminUpload(input){
      var file=input.files&&input.files[0];if(!file)return;
      if(file.size>5*1024*1024){alertError('ไฟล์ต้องมีขนาดไม่เกิน 5 MB');input.value='';return;}
      var folder=prompt('เลือกโฟลเดอร์ (Products, Categories, Banners, Website, Documents)','Products');if(!folder){input.value='';return;}
      var allowed=['Products','Categories','Banners','Website','Documents'];if(allowed.indexOf(folder)<0){alertError('โฟลเดอร์ไม่ถูกต้อง');input.value='';return;}
      var isPrivate=folder==='Documents';
      var reader=new FileReader();reader.onload=function(){apiCall('uploadFile',[APP.adminToken,{folder:folder,name:file.name,mimeType:file.type,data:reader.result,visibility:isPrivate?'private':'public'}],function(r){
        if(!r.success){alertError(r.message);return;}
        if(r.data&&r.data.public){Swal.fire({icon:'success',title:'อัปโหลดสำเร็จ',html:'<div class="modal-form-grid single"><div class="modal-field"><label for="uploadedUrl">URL รูปภาพ</label><input id="uploadedUrl" value="'+esc(r.data.url)+'" readonly></div><p class="modal-help">ต้นฉบับเก็บเป็น Private ใน Drive และเว็บไซต์แสดงผ่าน Image Service ที่ตรวจสิทธิ์แล้ว</p></div>',confirmButtonText:'คัดลอก URL'}).then(function(){var e=document.getElementById('uploadedUrl');if(e){e.select();document.execCommand('copy');}});}
        else{Swal.fire({icon:'info',title:'บันทึกไฟล์ใน Google Drive แล้ว',html:'<p>'+(isPrivate?'ไฟล์นี้จัดเก็บเป็นส่วนตัวในโฟลเดอร์ Documents':'ไฟล์ถูกบันทึกแล้ว แต่ Drive ไม่อนุญาตให้แชร์สาธารณะ')+'</p><p class="modal-help">'+esc((r.data&&r.data.warning)||'ไฟล์ส่วนตัวไม่สามารถแสดงบนหน้าร้านสาธารณะได้')+'</p><div class="modal-field"><label>File ID</label><input value="'+esc(r.data&&r.data.fileId||'')+'" readonly></div>',confirmButtonText:'ปิด'});}
      },true,'กำลังอัปโหลดไฟล์...');};reader.onerror=function(){alertError('ไม่สามารถอ่านไฟล์ได้');};reader.readAsDataURL(file);input.value='';
    }
