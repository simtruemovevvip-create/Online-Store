    function initHomeHeroSwiper(){
      var node=document.querySelector('.home-hero-swiper');
      if(!node||!window.Swiper)return;
      if(homeHeroSwiperInstance&&typeof homeHeroSwiperInstance.destroy==='function'){
        try{homeHeroSwiperInstance.destroy(true,true);}catch(ignore){}
        homeHeroSwiperInstance=null;
      }
      var count=node.querySelectorAll('.swiper-slide').length;
      if(count<2){
        var prev=node.querySelector('.home-hero-swiper-prev'),next=node.querySelector('.home-hero-swiper-next'),dots=node.querySelector('.home-hero-swiper-pagination');
