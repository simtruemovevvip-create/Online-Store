      // the inner frame (which can produce 'script.google.com refused to connect').
      try{
        if(window.top&&window.top!==window.self){window.top.location.assign(url);return true;}
      }catch(topNavigationError){}
      try{
        var link=document.createElement('a');link.href=url;link.target='_top';link.rel='noopener';
        link.style.display='none';document.body.appendChild(link);link.click();
        setTimeout(function(){if(link.parentNode)link.parentNode.removeChild(link);},1000);
        return true;
      }catch(linkNavigationError){
        try{window.location.assign(url);return true;}catch(fallbackNavigationError){return false;}
      }
    }
