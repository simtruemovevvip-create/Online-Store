        loop:count>1,
        speed:550,
        slidesPerView:1,
        spaceBetween:0,
        watchOverflow:true,
        autoplay:count>1?{delay:4200,disableOnInteraction:false,pauseOnMouseEnter:true}:false,
        navigation:{nextEl:node.querySelector('.home-hero-swiper-next'),prevEl:node.querySelector('.home-hero-swiper-prev')},
