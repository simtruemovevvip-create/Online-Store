    function renderHomeHero(){
      var banners=safeArray(APP.banners).filter(function(b){return !!b;});
      var sidePattern=/(^|[-_])(side|right|secondary)([-_]|$)/i;
      var mainPattern=/(^|[-_])(main|hero|carousel|home)([-_]|$)/i;
      var explicitSide=banners.filter(function(b){return sidePattern.test(homeBannerPosition(b));}).sort(function(a,b){
        function rank(item){var pos=homeBannerPosition(item);return pos==='side-top'?0:(pos==='side-bottom'?1:2);}
        return rank(a)-rank(b)||Number(a.order||0)-Number(b.order||0);
      });
      var explicitMain=banners.filter(function(b){return mainPattern.test(homeBannerPosition(b))&&!sidePattern.test(homeBannerPosition(b));});
      var otherBanners=banners.filter(function(b){return !sidePattern.test(homeBannerPosition(b));});
      var mainBanners=explicitMain.length?explicitMain:otherBanners;
      if(!mainBanners.length)mainBanners=banners.slice();
      var slides=mainBanners.filter(function(b){return String(b.image||'').trim();});
      if(!slides.length&&String(APP.settings.heroImage||'').trim()){
        slides=[{id:'settings-hero',title:APP.settings.storeName||'Online Store',description:APP.settings.storeDescription||'สินค้าคุณภาพ ส่งตรงถึงคุณ',image:APP.settings.heroImage,url:'#products'}];
      }
      if(!slides.length){
        slides=[{id:'store-fallback',title:APP.settings.storeName||'Online Store',description:APP.settings.storeDescription||'สินค้าคุณภาพ ส่งตรงถึงคุณ',image:'',url:'#products'}];
      }

      var sideBanners=explicitSide.filter(function(b){return String(b.image||'').trim();}).slice(0,2);
      var sidePool=mainBanners.filter(function(b){return String(b.image||'').trim();});
      if(sidePool.length>1)sidePool=sidePool.slice(1).concat(sidePool.slice(0,1));
      if(String(APP.settings.heroImage||'').trim()){
        sidePool.push({id:'settings-hero-side',title:APP.settings.storeName||'Online Store',image:APP.settings.heroImage,url:'#products'});
      }
      sidePool=sidePool.filter(function(b){return String(b.image||'').trim();});
      for(var i=0;i<sidePool.length&&sideBanners.length<2;i++){
        var candidate=sidePool[i],duplicate=sideBanners.some(function(x){return String(x.id||x.image)===String(candidate.id||candidate.image);});
        if(!duplicate)sideBanners.push(candidate);
      }
      if(sideBanners.length===1)sideBanners.push(sideBanners[0]);
      while(sideBanners.length<2)sideBanners.push({title:APP.settings.storeName||'Online Store',description:APP.settings.storeDescription||'สินค้าคุณภาพ ส่งตรงถึงคุณ',image:''});

      var slideMarkup=slides.map(function(b){return '<div class="swiper-slide">'+homeBannerMarkup(b,'')+'</div>';}).join('');
      var sideMarkup=sideBanners.slice(0,2).map(function(b,index){
        return '<div class="home-hero-side-item">'+homeBannerMarkup(b,'home-hero-side-banner')+'</div>';
      }).join('');
      return '<section class="home-hero-layout" aria-label="แบนเนอร์หน้าร้าน">'+
        '<div class="swiper home-hero-swiper'+(slides.length<2?' is-single-slide':'')+'">'+
          '<div class="swiper-wrapper">'+slideMarkup+'</div>'+
          '<button type="button" class="home-hero-swiper-prev" aria-label="แบนเนอร์ก่อนหน้า"><i class="fa-solid fa-chevron-left"></i></button>'+
          '<button type="button" class="home-hero-swiper-next" aria-label="แบนเนอร์ถัดไป"><i class="fa-solid fa-chevron-right"></i></button>'+
          '<div class="home-hero-swiper-pagination"></div>'+
        '</div>'+
        '<div class="home-hero-side">'+sideMarkup+'</div>'+
      '</section>';
    }
