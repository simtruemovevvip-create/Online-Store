    function customerPurchaseBucket(order){
      var status=String(order&&order.orderStatus||'Pending'),payment=String(order&&order.paymentStatus||''),method=String(order&&order.paymentMethod||'');
      if(status==='Refunded'||(status==='Cancelled'&&payment==='Verified'))return 'returns';
      if(status==='Cancelled')return 'cancelled';
      if(status==='Completed')return 'completed';
      if(status==='Shipped'||status==='Delivered')return 'receiving';
      if(status==='Processing'||status==='Packed'||status==='Paid')return 'shipping';
      if(status==='Pending'||status==='Awaiting Payment'){
        if(method==='cod'||payment==='Verified')return 'shipping';
        return 'unpaid';
      }
      if(payment==='Unpaid'||payment==='Rejected'||payment==='Pending Verification')return 'unpaid';
      return 'shipping';
    }
