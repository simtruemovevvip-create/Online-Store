    function downloadSalesReport(format){var filters={startDate:document.getElementById('reportStart').value,endDate:document.getElementById('reportEnd').value};apiCall('exportReport',[APP.adminToken,format,filters],function(r){if(!r.success){alertError(r.message);return;}var blob;if(format==='csv')blob=new Blob(['\ufeff'+r.data.content],{type:r.data.mimeType});else{var raw=atob(r.data.contentBase64);var bytes=new Uint8Array(raw.length);for(var i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);blob=new Blob([bytes],{type:r.data.mimeType});}var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download=r.data.filename;a.click();URL.revokeObjectURL(url);toast('Export '+format.toUpperCase()+' สำเร็จ');},true,'กำลังสร้างไฟล์รายงาน...');}
